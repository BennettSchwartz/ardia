--- a/content/browser/media/session/media_session_controller.cc
+++ b/content/browser/media/session/media_session_controller.cc
@@ -16,5 +16,11 @@
 #include "media/base/media_content_type.h"

 namespace content {
+
+// Ardia: the Windows engine sets this at startup, for every WebContents in
+// the process, so a muted tab keeps its heard players in its media session
+// and the playing card still reports and controls them, as on the Mac.
+CONTENT_EXPORT extern bool g_ardia_win_keep_muted_media_sessions;
+CONTENT_EXPORT bool g_ardia_win_keep_muted_media_sessions = false;

 int MediaSessionController::player_count_ = 0;
@@ -290,6 +296,9 @@

   // We want to make sure we do not request audio focus on a muted tab as it
   // would break user expectations by pausing/ducking other playbacks.
-  return has_audio_ && !web_contents_->IsAudioMuted();
+  // Ardia: audio focus is not enforced on Windows, so a muted tab's session
+  // ducks and pauses nothing there; has_audio_ already means it was heard.
+  return has_audio_ && (g_ardia_win_keep_muted_media_sessions ||
+                        !web_contents_->IsAudioMuted());
 }

