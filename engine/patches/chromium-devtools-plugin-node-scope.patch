+bool InspectorDOMAgent::ArdiaOwnsBackendNode(Node* node) const {
+  if (!ardia_owned_backend_nodes_only_) {
+    return true;
+  }
+  LocalFrame* frame = node->GetDocument().GetFrame();
+  return frame && inspected_frames_->Contains(frame);
