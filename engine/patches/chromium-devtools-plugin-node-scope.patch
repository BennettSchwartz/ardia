+void EventHandler::ArdiaEndDragAtSource(const WebMouseEvent& event) {
+  Node* drag_source = mouse_event_manager_->GetDragState().drag_src_.Get();
+  LocalFrame* source_frame =
+      drag_source ? drag_source->GetDocument().GetFrame() : nullptr;
+  EventHandler& handler =
+      source_frame && source_frame->Tree().IsDescendantOf(frame_)
+          ? source_frame->GetEventHandler()
+          : *this;
+  handler.mouse_event_manager_->DragSourceEndedAt(
+      event, ui::mojom::blink::DragOperation::kNone);
+  handler.gesture_manager_->HandleTouchDragEnd(
+      event, ui::mojom::blink::DragOperation::kNone);
+}
