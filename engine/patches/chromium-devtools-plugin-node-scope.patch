+bool ArdiaPluginWorldTouchesClipboard(const String& command_name,
+                                      ExecutionContext* context) {
+  if (!context || !(EqualIgnoringAsciiCase(command_name, "copy") ||
+                    EqualIgnoringAsciiCase(command_name, "cut") ||
+                    EqualIgnoringAsciiCase(command_name, "paste"))) {
+    return false;
+  }
+  v8::Isolate* isolate = context->GetIsolate();
+  if (!isolate || !isolate->InContext()) {
+    return false;
+  }
+  const DOMWrapperWorld& ardia_world = DOMWrapperWorld::Current(isolate);
+  return ardia_world.GetWorldType() ==
+             DOMWrapperWorld::WorldType::kInspectorIsolated &&
+         ardia_world.NonMainWorldHumanReadableName().starts_with(
+             "ardia-plugin-");
+}
